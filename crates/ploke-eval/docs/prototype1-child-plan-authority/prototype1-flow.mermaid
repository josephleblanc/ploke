%%{init: {"theme": "base", "flowchart": {"htmlLabels": false, "curve": "basis", "nodeSpacing": 45, "rankSpacing": 70}, "themeVariables": {"background": "#ffffff", "textColor": "#1e1e1e", "lineColor": "#495057", "fontFamily": "Inter, Arial, sans-serif"}}}%%
%% Prototype 1 diagrams regenerated as small multiples.
%% Full per-step accounting lives in prototype1-record-inventory.md.
%% Authority cue: ChildPlan governs pre-runtime child admission;
%% the per-runtime Channel governs child and successor lifecycle messages;
%% sealed History governs lineage and handoff after selection.
%% Journals, registries, run roots, latest-run files, and DB snapshots are projections or witnesses.
flowchart LR
    classDef cli fill:#e9ecef,stroke:#495057,stroke-width:2px
    classDef parent fill:#d0bfff,stroke:#1e1e1e,stroke-width:2px
    classDef child fill:#b2f2bb,stroke:#1e1e1e,stroke-width:2px
    classDef select fill:#fff3bf,stroke:#1e1e1e,stroke-width:2px
    classDef successor fill:#ffd8a8,stroke:#1e1e1e,stroke-width:2px
    classDef records fill:#c3fae8,stroke:#087f5b,stroke-width:1px,stroke-dasharray: 4 4
    classDef caution fill:#ffc9c9,stroke:#1e1e1e,stroke-width:1px,stroke-dasharray: 4 4

    A["prototype1-state"]:::cli --> B["Parent startup / admission"]:::parent
    B --> C["Baseline + parent-owned ChildPlan"]:::parent
    C --> D["Child attempt fanout<br/>C1-C5"]:::child
    D --> E["Compare from channel treatment evidence<br/>+ outcome list"]:::child
    E --> F["Select successor"]:::select
    F --> G{"Continuation allowed?"}:::select
    G -- no --> H["Record stopped"]:::select
    G -- yes --> I["Install selected Artifact"]:::successor
    I --> J["Seal History block"]:::successor
    J --> K["Spawn successor<br/>--handoff-invocation"]:::successor
    K --> L["Successor re-enters<br/>and sends SuccessorReady"]:::successor
    L --> M["Predecessor observes<br/>SuccessorReady"]:::successor
    M -. next generation .-> B

    R1["Parent records<br/>parent_identity<br/>run-profile<br/>child-plan<br/>transition journal"]:::records
    R2["Child attempt records<br/>node + runner request/result projections<br/>invocation + terminal channel Result<br/>run root + agent turn<br/>index/DB witnesses"]:::records
    R3["Selection records<br/>evaluations<br/>candidate set<br/>metric set + formula<br/>selection entry"]:::records
    R4["Authority-bearing surfaces<br/>ChildPlan message<br/>terminal channel Result<br/>sealed History blocks<br/>admitted entries + surface commitments<br/>successor invocation bootstrap"]:::records
    W["Keep this as the map of causality.<br/>Use the inventory table and detail maps for file accounting."]:::caution

    C -. emits/reads .-> R1
    D -. emits .-> R2
    F -. seals .-> R3
    J -. authority .-> R4
    W -.-> R1
