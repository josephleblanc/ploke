%%{init: {"theme": "base", "flowchart": {"htmlLabels": false, "curve": "basis", "nodeSpacing": 45, "rankSpacing": 70}, "themeVariables": {"background": "#ffffff", "textColor": "#1e1e1e", "lineColor": "#495057", "fontFamily": "Inter, Arial, sans-serif"}}}%%
%% Prototype 1 diagrams regenerated as small multiples.
%% Full per-step accounting lives in prototype1-record-inventory.md.
%% Authority cue: selection is evidence, continuation is the gate,
%% sealed History retires the predecessor, and the successor then re-enters
%% through its handoff invocation before acknowledging readiness on the Channel.
flowchart LR
    classDef parent fill:#d0bfff,stroke:#1e1e1e,stroke-width:2px
    classDef select fill:#fff3bf,stroke:#1e1e1e,stroke-width:2px
    classDef successor fill:#ffd8a8,stroke:#1e1e1e,stroke-width:2px
    classDef authority fill:#ffc9c9,stroke:#1e1e1e,stroke-width:2px
    classDef records fill:#c3fae8,stroke:#087f5b,stroke-width:1px,stroke-dasharray: 4 4
    classDef projection fill:#f8f9fa,stroke:#868e96,stroke-width:1px,stroke-dasharray: 3 3,color:#343a40

    subgraph Selection["selection and continuation"]
        direction LR
        A["child outcomes"]:::parent --> B["assemble selection input"]:::select
        B --> C["select successor"]:::select
        C --> D["continuation gate"]:::authority
        D -- stopped --> E["append stopped record"]:::select
        D -- allowed --> F["selected Artifact for handoff"]:::successor
    end

    subgraph Handoff["authority transfer"]
        direction LR
        F --> G["install selected Artifact<br/>in active checkout"]:::successor
        G --> H["Parent<Selectable><br/>locks lineage"]:::authority
        H --> I["seal + append History block"]:::authority
        I --> J["write successor invocation"]:::successor
        J --> K["spawn successor<br/>--handoff-invocation"]:::successor
        K --> L["successor validates handoff<br/>and sends SuccessorReady"]:::successor
        L --> M["predecessor observes<br/>SuccessorReady"]:::successor
    end

    subgraph SelectionRecords["selection material"]
        direction TB
        R1["evaluation evidence<br/>evaluations/<branch>.json<br/>compared run refs<br/>oracle/protocol metrics"]:::records
        R2["History-backed decision<br/>SelectionDecisionEntryRecord<br/>CandidateSet/Membership/Occurrence<br/>EvaluationPayload"]:::records
        R3["scoring material<br/>MetricSet<br/>Formula<br/>ImpAtK<br/>TraversalEvidence<br/>ProjectionFailure"]:::records
        R4["continuation checks<br/>run-profile.toml<br/>node count<br/>ParentStarted count<br/>selected node + branch disposition"]:::projection
    end

    subgraph HandoffRecords["handoff records"]
        direction TB
        H1["active checkout mutation<br/>parent_identity.json<br/>ActiveCheckoutAdvanced journal entry<br/>selected surface commitment"]:::records
        H2["History authority<br/>history/blocks/segment-*.jsonl<br/>admitted artifact claim<br/>selection entry<br/>operational environment"]:::authority
        H3["successor bootstrap + ack<br/>invocations/<runtime>.json<br/>channels/<runtime>/*.jsonl<br/>streams/<runtime>/*.log<br/>successor-ready/completion records"]:::records
    end

    B -. reads .-> R1
    C -. seals .-> R2
    C -. uses .-> R3
    D -. checks .-> R4
    G -. writes .-> H1
    I -. appends .-> H2
    J -. writes .-> H3
    L -. writes .-> H3
    M -. reads/writes .-> H3
