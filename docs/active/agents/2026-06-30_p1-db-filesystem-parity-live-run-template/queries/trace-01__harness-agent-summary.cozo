?[request_id, parent_node_id, request_path, prompt_path, workspace_path, child_min, child_max, graph_nearest, terminal_kind, terminal_detail, attempts, tool_requests, tool_completed, tool_failed, proposals, outcomes, turn_id, selected_model, provider, route_source, event_count, response_count, terminal_outcome, trace_ref, summary_ref] :=
  *eval_harness_request{
